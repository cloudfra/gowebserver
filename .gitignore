# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.a
*.dll
*.dylib
*.exe
*.exe~
*.o
*.so
*.so

# Code coverage profiles and other test artifacts
*.coverage
*.coverprofile
*.log
*.out
*.prof
*.pt
*.test
benchmark.html
coverage.*
profile.cov


# Dependency directories (remove the comment below to include it)
# vendor/

# Go temp files
__debug_bin
__debug_bin.exe
_cgo_defun.c
_cgo_export.*
_cgo_gotypes.go
_testmain.go
*.cgo1.go
*.cgo2.c
go.work
go.work.sum

# env file
.env

# Note: intentionally does not match .terraform.lock.hcl, which should be
# committed to pin provider versions/hashes for reproducible builds.
.terraform/
.terraformrc

# Folders
_obj
_test

# Architecture specific extensions/prefixes
[568vq].out
*.[568vq]

# Bazel
bazel-bin
bazel-genfiles
bazel-gowebserver
bazel-out
bazel-testlogs

# Editor/IDE
.claude/
.idea/
.vscode/

# Output Directories
build/
output/

# Sensitive files
/web.cert
/web.key
gha-creds-*.json

